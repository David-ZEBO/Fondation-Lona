{
	"$schema": "https://schemas.wp.org/wp/6.7/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": false,
			"customGradient": false,
			"palette": [
				{ "slug": "primary", "name": "Bleu institutionnel", "color": "#142E55" },
				{ "slug": "secondary", "name": "Bleu logo", "color": "#23408C" },
				{ "slug": "deep", "name": "Bleu nuit", "color": "#0C1E3B" },
				{ "slug": "gold", "name": "Or", "color": "#C9A348" },
				{ "slug": "gold-light", "name": "Or clair", "color": "#E3C77F" },
				{ "slug": "gold-dark", "name": "Or foncé (texte sur fond clair)", "color": "#8A6A1F" },
				{ "slug": "white", "name": "Blanc", "color": "#FFFFFF" },
				{ "slug": "light", "name": "Gris clair", "color": "#F4F6F9" },
				{ "slug": "body-text", "name": "Texte", "color": "#263449" }
			],
			"gradients": [
				{ "slug": "navy-veil", "name": "Voile bleu marine", "gradient": "linear-gradient(100deg, rgba(12,30,59,0.92) 0%, rgba(20,46,85,0.72) 45%, rgba(20,46,85,0.25) 100%)" },
				{ "slug": "navy-fade", "name": "Dégradé marine", "gradient": "linear-gradient(180deg, #142E55 0%, #0C1E3B 100%)" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{ "slug": "heading", "name": "Manrope", "fontFamily": "Manrope, \"Segoe UI\", system-ui, -apple-system, sans-serif" },
				{ "slug": "body", "name": "Inter", "fontFamily": "Inter, \"Segoe UI\", system-ui, -apple-system, Roboto, sans-serif" },
				{ "slug": "editorial", "name": "Playfair Display", "fontFamily": "\"Playfair Display\", Georgia, \"Times New Roman\", serif" }
			],
			"fontSizes": [
				{ "slug": "x-small", "name": "Très petit", "size": "0.8125rem", "fluid": false },
				{ "slug": "small", "name": "Petit", "size": "0.9375rem", "fluid": false },
				{ "slug": "medium", "name": "Normal", "size": "1.0625rem", "fluid": false },
				{ "slug": "large", "name": "Grand", "size": "1.375rem", "fluid": { "min": "1.2rem", "max": "1.375rem" } },
				{ "slug": "x-large", "name": "Très grand", "size": "2rem", "fluid": { "min": "1.6rem", "max": "2rem" } },
				{ "slug": "xx-large", "name": "Titre de section", "size": "2.75rem", "fluid": { "min": "2rem", "max": "2.75rem" } },
				{ "slug": "display", "name": "Affichage", "size": "4.25rem", "fluid": { "min": "2.4rem", "max": "4.25rem" } }
			]
		},
		"spacing": {
			"units": [ "px", "rem", "%", "vh", "vw" ],
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{ "slug": "20", "name": "XS", "size": "0.5rem" },
				{ "slug": "30", "name": "S", "size": "1rem" },
				{ "slug": "40", "name": "M", "size": "1.5rem" },
				{ "slug": "50", "name": "L", "size": "clamp(1.75rem, 3vw, 2.5rem)" },
				{ "slug": "60", "name": "XL", "size": "clamp(2.5rem, 5vw, 4rem)" },
				{ "slug": "70", "name": "XXL", "size": "clamp(3.5rem, 8vw, 7rem)" }
			]
		},
		"layout": { "contentSize": "760px", "wideSize": "1240px" },
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{ "slug": "soft", "name": "Douce", "shadow": "0 18px 40px -18px rgba(12,30,59,0.28)" }
			]
		},
		"blocks": {
			"core/image": { "lightbox": { "enabled": true, "allowEditing": true } },
			"core/gallery": { "lightbox": { "enabled": true } }
		}
	},
	"styles": {
		"color": { "background": "var:preset|color|white", "text": "var:preset|color|body-text" },
		"spacing": {
			"blockGap": "1.5rem",
			"padding": { "left": "clamp(1rem, 4vw, 2.5rem)", "right": "clamp(1rem, 4vw, 2.5rem)", "top": "0", "bottom": "0" }
		},
		"typography": {
			"fontFamily": "var:preset|font-family|body",
			"fontSize": "var:preset|font-size|medium",
			"lineHeight": "1.7"
		},
		"elements": {
			"link": {
				"color": { "text": "var:preset|color|secondary" },
				"typography": { "textDecoration": "underline" },
				":hover": { "color": { "text": "var:preset|color|primary" } },
				":focus": { "color": { "text": "var:preset|color|primary" } }
			},
			"heading": {
				"color": { "text": "var:preset|color|primary" },
				"typography": { "fontFamily": "var:preset|font-family|heading", "fontWeight": "700", "lineHeight": "1.15", "letterSpacing": "-0.02em" }
			},
			"h1": { "typography": { "fontSize": "var:preset|font-size|display", "fontWeight": "800" } },
			"h2": { "typography": { "fontSize": "var:preset|font-size|xx-large" } },
			"h3": { "typography": { "fontSize": "var:preset|font-size|x-large", "lineHeight": "1.25" } },
			"h4": { "typography": { "fontSize": "var:preset|font-size|large", "lineHeight": "1.3" } },
			"h5": { "typography": { "fontSize": "var:preset|font-size|medium" } },
			"h6": { "typography": { "fontSize": "var:preset|font-size|small", "textTransform": "uppercase", "letterSpacing": "0.12em" } },
			"button": {
				"color": { "background": "var:preset|color|primary", "text": "var:preset|color|white" },
				"typography": { "fontFamily": "var:preset|font-family|heading", "fontWeight": "700", "fontSize": "0.975rem", "letterSpacing": "0.01em" },
				"border": { "radius": "999px" },
				"spacing": { "padding": { "top": "0.95rem", "bottom": "0.95rem", "left": "1.75rem", "right": "1.75rem" } },
				":hover": { "color": { "background": "var:preset|color|secondary", "text": "var:preset|color|white" } },
				":focus": { "color": { "background": "var:preset|color|secondary", "text": "var:preset|color|white" } }
			},
			"caption": { "typography": { "fontSize": "var:preset|font-size|x-small" }, "color": { "text": "#5B6577" } }
		},
		"blocks": {
			"core/navigation": { "typography": { "fontFamily": "var:preset|font-family|heading", "fontSize": "0.95rem", "fontWeight": "600" } },
			"core/quote": {
				"typography": { "fontFamily": "var:preset|font-family|editorial", "fontSize": "var:preset|font-size|large", "fontStyle": "italic" },
				"border": { "left": { "color": "var:preset|color|gold", "width": "3px", "style": "solid" } },
				"spacing": { "padding": { "left": "var:preset|spacing|40" } }
			},
			"core/pullquote": { "typography": { "fontFamily": "var:preset|font-family|editorial" } },
			"core/post-title": { "typography": { "fontFamily": "var:preset|font-family|heading" } },
			"core/post-date": { "typography": { "fontSize": "var:preset|font-size|x-small" } },
			"core/separator": { "color": { "text": "var:preset|color|gold" } },
			"core/site-title": { "typography": { "fontFamily": "var:preset|font-family|heading", "fontWeight": "800", "fontSize": "1.35rem" } }
		}
	},
	"templateParts": [
		{ "name": "header", "title": "En-tête", "area": "header" },
		{ "name": "footer", "title": "Pied de page", "area": "footer" },
		{ "name": "page-header", "title": "Bandeau de page", "area": "uncategorized" }
	],
	"customTemplates": [
		{ "name": "page-editorial", "title": "Page éditoriale (sans bandeau)", "postTypes": [ "page" ] }
	]
}
