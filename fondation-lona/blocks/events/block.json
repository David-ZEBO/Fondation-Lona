{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "lona/events",
	"title": "Événements",
	"category": "lona",
	"icon": "calendar-alt",
	"description": "Liste des événements à venir ou passés.",
	"textdomain": "fondation-lona",
	"attributes": {
		"count": {
			"type": "number",
			"default": 3
		},
		"scope": {
			"type": "string",
			"default": "upcoming",
			"enum": [
				"upcoming",
				"past",
				"all"
			]
		}
	},
	"supports": {
		"html": false,
		"align": [
			"wide",
			"full"
		],
		"anchor": true
	},
	"editorScript": "lona-blocks-editor",
	"render": "file:./render.php"
}